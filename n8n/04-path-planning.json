      "id": "ec4ede25-bed4-448a-aa24-7866aa2b5425",
      "name": "Normalize Path Data"
    },
    {
      "parameters": {
        "jsCode": "const d = $json;\n\nconst dx = d.goal_x - d.start_x;\nconst dy = d.goal_y - d.start_y;\n\nconst distance = Math.sqrt(dx * dx + dy * dy);\n\nconst obstacleOnDirectPath =\n  Math.abs(\n    (d.obstacle_y - d.start_y) * dx -\n    (d.obstacle_x - d.start_x) * dy\n  ) < 1.5;\n\nlet path_type = \"DIRECT\";\nlet planning_action = \"PROCEED\";\n\nif (obstacleOnDirectPath) {\n  path_type = \"ALTERNATE\";\n  planning_action = \"REROUTE\";\n}\n\nreturn {\n  json: {\n    ...d,\n    distance: Number(distance.toFixed(2)),\n    path_type,\n    planning_action\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
