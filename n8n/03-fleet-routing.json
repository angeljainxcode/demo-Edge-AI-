    {
      "parameters": {
        "jsCode": "const d = $json;\n\nconst dx = d.destination_x - d.current_x;\nconst dy = d.destination_y - d.current_y;\n\nconst distance = Math.sqrt(dx * dx + dy * dy);\n\nlet route_type = \"DIRECT\";\nlet routing_action = \"PROCEED\";\n\nif (d.traffic_level === \"high\") {\n  route_type = \"ALTERNATE\";\n  routing_action = \"REROUTE\";\n}\n\nif (d.battery <= 20) {\n  routing_action = \"CHARGE_FIRST\";\n}\n\nreturn {\n  json: {\n    ...d,\n    distance: Number(distance.toFixed(2)),\n    route_type,\n    routing_action\n  }\n};"
      },
