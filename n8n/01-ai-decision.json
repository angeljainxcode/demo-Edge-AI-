    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "models/gemini-flash-lite-latest",
          "mode": "list",
          "cachedResultName": "models/gemini-flash-lite-latest"
        },
        "messages": {
          "values": [
            {
              "content": "=You are the AI decision engine for an autonomous AMR fleet.\n\nAnalyze the robot's current state and decide the safest appropriate action.\n\nRobot ID: {{$json.vehicle_id}}\nBattery: {{$json.battery}}%\nSpeed: {{$json.speed}}\nMission Status: {{$json.mission_status}}\nCurrent Position: ({{$json.x}}, {{$json.y}})\nObstacle Detected: {{$json.obstacle_detected}}\nTraffic Level: {{$json.traffic_level}}\nDestination: ({{$json.destination_x}}, {{$json.destination_y}})\n\nPossible decisions:\nCONTINUE\nSLOW_DOWN\nREROUTE\nSTOP\nRECHARGE\n\nReturn ONLY valid JSON:\n\n{\n  \"vehicle_id\": \"\",\n  \"decision\": \"\",\n  \"risk_level\": \"\",\n  \"reason\": \"\",\n  \"recommended_action\": \"\"\n}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        448,
        32
      ],
      "id": "17f07a8a-5f0e-49a4-a584-e7599de5c0d4",
      "name": "AI Decision Engine",
      "alwaysOutputData": false,
      "credentials": {
        "googlePalmApi": {
          "id": "5ATFPful6ppWnaDX",
          "name": "Google Gemini(PaLM) Api account 3"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const d = $json;\n\nlet decision = \"CONTINUE\";\nlet risk_level = \"LOW\";\nlet reason = \"Normal operating conditions.\";\nlet recommended_action = \"Continue toward destination.\";\n\nif (d.obstacle_detected === true) {\n  decision = \"STOP\";\n  risk_level = \"HIGH\";\n  reason = \"Obstacle detected.\";\n  recommended_action = \"Stop immediately.\";\n} \nelse if (d.battery <= 20) {\n  decision = \"RECHARGE\";\n  risk_level = \"HIGH\";\n  reason = \"Battery level is critically low.\";\n  recommended_action = \"Proceed to charging station.\";\n} \nelse if (d.traffic_level === \"high\") {\n  decision = \"SLOW_DOWN\";\n  risk_level = \"MEDIUM\";\n  reason = \"High traffic detected.\";\n  recommended_action = \"Reduce speed and maintain safe distance.\";\n} \nelse if (d.speed > 3) {\n  decision = \"SLOW_DOWN\";\n  risk_level = \"MEDIUM\";\n  reason = \"Vehicle speed is above the safe threshold.\";\n  recommended_action = \"Reduce speed.\";\n}\nreturn {\n  json: {\n    vehicle_id: d.vehicle_id || \"AGV_01\",\n    decision,\n    risk_level,\n    reason,\n    recommended_action\n  }\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1024,
        128
      ],
      "id": "4b467e03-601a-4ac9-ab0c-bd1dddd0b069",
      "name": "Backup Decision Engine"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "f292b4f9-25cf-4673-9c82-8f6024a88696",
              "leftValue": "={{ $json.content.parts[0].text }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        800,
        32
      ],
      "id": "26f285b4-9ff6-4986-bfdf-6950339533f3",
      "name": "AI Response Check"
    },
    {
      "parameters": {
        "jsCode": "const text = $json.content?.parts?.[0]?.text || \"\";\n\nlet decision;\n\ntry {\n  decision = JSON.parse(text);\n} catch (error) {\n  decision = {\n    vehicle_id: \"AMR_01\",\n    decision: \"STOP\",\n    risk_level: \"HIGH\",\n    reason: \"AI response could not be parsed.\",\n    recommended_action: \"Stop and reassess.\"\n  };\n}\n\nreturn {\n  json: decision\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1024,
        -64
      ],
      "id": "134f5f21-4d83-4495-ac3d-22e988c212bf",
