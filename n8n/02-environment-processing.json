      "id": "dfd084e2-6ba9-411a-97dc-c5e37c11009f",
      "name": "Normalize Environment Data"
    },
    {
      "parameters": {
        "jsCode": "const d = $json;\n\nlet environment_status = \"NORMAL\";\nlet risk_level = \"LOW\";\nlet recommended_action = \"CONTINUE\";\n\nif (d.obstacle_detected === true) {\n  environment_status = \"OBSTACLE\";\n  risk_level = \"HIGH\";\n  recommended_action = \"STOP_OR_REROUTE\";\n}\nelse if (d.traffic_level === \"high\") {\n  environment_status = \"CONGESTED\";\n  risk_level = \"MEDIUM\";\n  recommended_action = \"REDUCE_SPEED\";\n}\nelse if (d.temperature > 40 || d.temperature < 5) {\n  environment_status = \"EXTREME_TEMPERATURE\";\n  risk_level = \"MEDIUM\";\n  recommended_action = \"MONITOR_ENVIRONMENT\";\n}\nelse if (d.humidity > 85) {\n  environment_status = \"HIGH_HUMIDITY\";\n  risk_level = \"MEDIUM\";\n  recommended_action = \"MONITOR_ENVIRONMENT\";\n}\n\nreturn {\n  json: {\n    ...d,\n    environment_status,\n    risk_level,\n    recommended_action\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
